# TiTis on Decks - environment variables
#
# Copy this file to .env.local and fill in the blanks, or run
# `vercel env pull .env.local` to fetch the development values.
# In production every value is set in the Vercel project settings;
# .env.local itself is gitignored and never committed.

# --- Booking mail (api/booking.js) ---
# Resend API key that sends the mail - a sending-only key is enough. Required.
RESEND_API_KEY=
# Where booking notifications are delivered. Required.
BOOKING_TO=booking@titisondecks.com
# Verified sender. Optional - without it, Resend's onboarding sender is used,
# which only delivers to the account owner.
BOOKING_FROM="TiTis on Decks <booking@titisondecks.com>"

# --- Upload desk (api/upload.js, api/media.js) ---
# Shared passcode typed on the desk before uploading. Required.
UPLOAD_PASSCODE=
# Read/write token for the Vercel Blob store. In production it is injected
# automatically by the linked store; for local dev, pull it with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# --- Telegram pings (optional, used by both booking and upload) ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids to notify.
TELEGRAM_CHAT_IDS=
